model Source {
  id         String  @id @default(uuid())
  name       String
  mimeType   String
  storageKey String?

  document Json?

  moduleId String
  module   Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  processingStages SourceProcessingStage[]

  chunks       SourceChunk[]
  sourceTopics SourceTopic[]

  exercises Exercise[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([moduleId])
}

model SourceProcessingStage {
  id    String                    @id @default(uuid())
  stage SourceProcessingStageType
  state ProcessingState           @default(NOT_STARTED)

  errorMessage String? @db.Text

  startedAt   DateTime?
  completedAt DateTime?

  sourceId String
  source   Source @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sourceId, stage])
  @@index([state])
}

model SourceTopic {
  id        String @id @default(uuid())
  spanIndex Int

  title       String
  description String @db.Text

  detectionConfidence        Float?
  canonicalizationConfidence Float?

  startRef String?
  endRef   String?

  pageStart Int?
  pageEnd   Int?

  sourceId String
  source   Source @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  topicId String?
  topic   Topic?  @relation(fields: [topicId], references: [id], onDelete: SetNull)

  evidence TopicEvidence[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sourceId, spanIndex])
  @@index([sourceId])
  @@index([topicId])
}

model SourceChunk {
  id         String @id @default(uuid())
  chunkIndex Int

  content String @db.Text

  headingPath String[] @default([])

  pageStart Int?
  pageEnd   Int?

  startRef String?
  endRef   String?

  tokenCount Int?

  embedding Unsupported("vector")?

  sourceId String
  source   Source @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([sourceId, chunkIndex])
  @@index([sourceId])
}

enum SourceProcessingStageType {
  CONVERSION
  RAG_INDEXING
  TOPIC_ANALYSIS
}

enum ProcessingState {
  NOT_STARTED
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
}
