model Topic {
  id          String     @id @default(uuid())
  title       String
  description String     @db.Text
  state       TopicState @default(SUGGESTED)

  summary String? @db.Text

  contentRevision Int  @default(1)
  summaryRevision Int?

  moduleId String
  module   Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  sourceTopics SourceTopic[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([moduleId])
}

model TopicEvidence {
  id      String @id @default(uuid())
  content String @db.Text

  confidence Float?

  sourceTopicId String
  sourceTopic   SourceTopic @relation(fields: [sourceTopicId], references: [id], onDelete: Cascade)

  spans TopicEvidenceSpan[]

  createdAt DateTime @default(now())

  @@index([sourceTopicId])
}

model TopicEvidenceSpan {
  id String @id @default(uuid())

  content String @db.Text

  startRef String?
  endRef   String?

  pageStart Int?
  pageEnd   Int?

  topicEvidenceId String
  topicEvidence   TopicEvidence @relation(fields: [topicEvidenceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([topicEvidenceId])
}

enum TopicState {
  SUGGESTED
  CONFIRMED
  REJECTED
}
