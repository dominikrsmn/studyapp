model Topic {
  id          String     @id @default(uuid())
  title       String
  description String
  state       TopicState @default(SUGGESTED)
  summary     String?

  moduleId String
  module   Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  evidence TopicEvidence[]

  // parentId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  //parent    Topic?     @relation("TopicHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  //children  Topic[]    @relation("TopicHierarchy")
  //exercises Exercise[] @relation("ExerciseToTopic")
  //exerciseId String?
  //@@index([parentId])

  @@index([moduleId])
}

model TopicEvidence {
  id      String @id @default(uuid())
  content String

  topicId String
  topic   Topic  @relation(fields: [topicId], references: [id], onDelete: Cascade)

  provenance TopicEvidenceProvenance[]

  createdAt DateTime @default(now())

  @@index([topicId])
}

model TopicEvidenceProvenance {
  id              String @id @default(uuid())
  analysisChunkId String
  sourceId        String
  sourcePageId    String
  pageNumber      Int
  chunkIndex      Int
  startOffset     Int
  endOffset       Int
  content         String

  topicEvidenceId String
  topicEvidence   TopicEvidence @relation(fields: [topicEvidenceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([topicEvidenceId, analysisChunkId])
  @@index([analysisChunkId])
  @@index([sourceId])
  @@index([sourcePageId])
}

enum TopicState {
  SUGGESTED
  CONFIRMED
  REJECTED
}
