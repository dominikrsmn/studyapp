model Semester {
  id            String   @id @default(uuid())
  startDate     DateTime
  endDate       DateTime
  userId        String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  modules       Module[]
  user          User     @relation("UserSemesters", fields: [userId], references: [id], onDelete: Cascade)
  activeForUser User?    @relation("ActiveSemester")

  @@index([userId])
}

model Module {
  id          String    @id @default(uuid())
  name        String
  description String?
  icon        String    @default("book")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  examDate    DateTime?
  semesterId  String
  semester    Semester  @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  sources     Source[]
  topics      Topic[]

  graphVersion Int @default(1)
  learningGraphs LearningGraph[]

  @@index([semesterId])
}

model LearningGraph {
  id String @id @default(uuid())
  moduleId String
  module Module @relation(fields: [moduleId], references: [id])
  version Int @default(1)
  status ProcessingState

  createdAt DateTime @default(now())
  finishedAt DateTime?
  errorMessage String?
}
